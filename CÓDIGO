#include <WiFi.h>
#include <PubSubClient.h>
#include <Wire.h>
#include <LiquidCrystal_I2C.h>
#include <ESP32Servo.h>

// Configuración de Red Wi-Fi (Wokwi-GUEST en simulador no requiere contraseña)
const char* ssid = "Wokwi-GUEST";
const char* password = "";

// Configuración del Broker MQTT (Usamos el broker público de HiveMQ)
const char* mqtt_server = "broker.hivemq.com";
const int mqtt_port = 1883;

WiFiClient espClient;
PubSubClient client(espClient);

// Inicializar Pantalla LCD 16x2 por I2C (Dirección 0x27 o 0x3F)
LiquidCrystal_I2C lcd(0x27, 16, 2);

// Inicializar Servomotor para la barrera
Servo barreraServo;
const int servoPin = 13;

// Definición de Pines para los Sensores HC-SR04
const int trigPin1 = 5;
const int echoPin1 = 18;
const int trigPin2 = 17;
const int echoPin2 = 16;

// Variables de Control de Tiempo (Evita usar delay bloqueante)
unsigned long previousMillis = 0;
const long interval = 2000; // Leer sensores cada 2 segundos

void setup_wifi() {
  delay(10);
  Serial.println();
  Serial.print("Conectando a la red Wi-Fi: ");
  Serial.println(ssid);

  WiFi.begin(ssid, password);

  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
    Serial.print(".");
  }

  Serial.println("");
  Serial.println("¡Conexión Wi-Fi exitosa!");
  Serial.print("Dirección IP asignada: ");
  Serial.println(WiFi.localIP());
}

void reconnect() {
  // Bucle hasta lograr la conexión MQTT
  while (!client.connected()) {
    Serial.print("Intentando conexión MQTT...");
    // Crear un ID de cliente único
    String clientId = "SmartParkESP32-Client-";
    clientId += String(random(0xffff), HEX);
    
    if (client.connect(clientId.c_str())) {
      Serial.println(" ¡Conectado al Broker MQTT exitosamente!");
    } else {
      Serial.print(" Falló la conexión, rc=");
      Serial.print(client.state());
      Serial.print(" Reintentando en 5 segundos...");
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);

  // Configuración de pines de sensores
  pinMode(trigPin1, OUTPUT);
  pinMode(echoPin1, INPUT);
  pinMode(trigPin2, OUTPUT);
  pinMode(echoPin2, INPUT);

  // Configurar Servo y Pantalla LCD
  barreraServo.attach(servoPin);
  barreraServo.write(0); // Barrera cerrada por defecto
  
  lcd.init();
  lcd.backlight();
  lcd.setCursor(0, 0);
  lcd.print("SmartPark ESP32");
  lcd.setCursor(0, 1);
  lcd.print("Iniciando...");

  setup_wifi();
  client.setServer(mqtt_server, mqtt_port);
}

long medirDistancia(int trigPin, int echoPin) {
  digitalWrite(trigPin, LOW);
  delayMicroseconds(2);
  digitalWrite(trigPin, HIGH);
  delayMicroseconds(10);
  digitalWrite(trigPin, LOW);
  
  long duracion = pulseIn(echoPin, HIGH, 30000); // Timeout de 30ms
  long distancia = duracion * 0.034 / 2;
  if (distancia == 0) distancia = 100; // Si no hay rebote, asumir libre
  return distancia;
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  unsigned long currentMillis = millis();
  
  // Ejecutar lectura cada cierto intervalo sin bloquear el microcontrolador
  if (currentMillis - previousMillis >= interval) {
    previousMillis = currentMillis;

    // Medir distancias de ambos cajones
    long dist1 = medirDistancia(trigPin1, echoPin1);
    long dist2 = medirDistancia(trigPin2, echoPin2);

    // Lógica de Ocupación (Menor a 15 cm significa vehículo presente)
    bool cajon1Ocupado = dist1 < 15;
    bool cajon2Ocupado = dist2 < 15;

    int plazasLibres = 2;
    if (cajon1Ocupado) plazasLibres--;
    if (cajon2Ocupado) plazasLibres--;

    // Control Local del Servomotor y LCD
    lcd.clear();
    lcd.setCursor(0, 0);
    lcd.print("Plazas Libres: ");
    lcd.print(plazasLibres);

    lcd.setCursor(0, 1);
    if (plazasLibres > 0) {
      lcd.print("Acceso Permitido");
      barreraServo.write(90); // Abre la barrera
    } else {
      lcd.print("PARQUEO LLENO");
      barreraServo.write(0);  // Cierra/Bloquea la barrera
    }

    // Publicación de Telemetría vía MQTT hacia el Broker
    String payloadCajon1 = cajon1Ocupado ? "Ocupado" : "Libre";
    String payloadCajon2 = cajon2Ocupado ? "Ocupado" : "Libre";

    client.publish("smartpark/cajon1", payloadCajon1.c_str());
    client.publish("smartpark/cajon2", payloadCajon2.c_str());
    client.publish("smartpark/plazas", String(plazasLibres).c_str());

    // Imprimir Logs de depuración en consola local
    Serial.println("--- Reporte de Telemetría ---");
    Serial.print("Cajon 1: "); Serial.print(payloadCajon1); Serial.print(" (Dist: "); Serial.print(dist1); Serial.println(" cm)");
    Serial.print("Cajon 2: "); Serial.print(payloadCajon2); Serial.print(" (Dist: "); Serial.print(dist2); Serial.println(" cm)");
    Serial.print("Plazas Libres Totales: "); Serial.println(plazasLibres);
    Serial.println("-----------------------------");
  }
}
